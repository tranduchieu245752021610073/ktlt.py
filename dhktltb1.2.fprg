<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="dhktltb1.2"/>
        <attribute name="authors" value="Admin"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-05-14 11:42:30 SA"/>
        <attribute name="created" value="QWRtaW47QURNSU47MjAyNS0wNS0xNDsxMToxOTo1NyBTQTsyMTI4"/>
        <attribute name="edited" value="QWRtaW47QURNSU47MjAyNS0wNS0xNDsxMTo0MjozMCBTQTsxOzIyMjM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N" type="Integer" array="False" size=""/>
            <output expression="&quot; N : &quot;" newline="False"/>
            <input variable="N"/>
            <if expression="N=1">
                <then>
                    <output expression="&quot; N KHONG PHAI LA SO NT &quot;" newline="False"/>
                </then>
                <else/>
            </if>
            <if expression="N&gt;=4">
                <then>
                    <declare name="i" type="Integer" array="False" size=""/>
                    <assign variable="i" expression="2"/>
                    <while expression="N%i!=0">
                        <assign variable="i" expression="i+1"/>
                    </while>
                    <if expression="N==i">
                        <then>
                            <output expression="&quot; N la so nguyen to &quot;" newline="False"/>
                        </then>
                        <else>
                            <output expression="&quot; N khong phai la so nguyen to &quot;" newline="False"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="N&gt;=2">
                        <then>
                            <output expression="&quot; N SO NGUYEN TO &quot;" newline="False"/>
                        </then>
                        <else>
                            <output expression="&quot; N KHONG PHAI LA SO NGUYEN TO &quot;" newline="False"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
