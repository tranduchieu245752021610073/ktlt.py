    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Integer" array="False" size=""/>
            <output expression="&quot; Canh cua tam giac la : &quot;" newline="False"/>
            <input variable="a"/>
            <declare name="h" type="Integer" array="False" size=""/>
